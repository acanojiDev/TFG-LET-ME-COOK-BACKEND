// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

generator client {
  provider        = "prisma-client-js"
}

model comments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  post_id    String    @db.Uuid
  text       String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  /**
   * mentions      mentions[]
   * notifications notifications[]
   */

  @@schema("public")
}

model follows {
  follower_id                      String    @db.Uuid
  followed_id                      String    @db.Uuid
  followed_at                      DateTime? @default(now()) @db.Timestamptz(6)
  users_follows_followed_idTousers users     @relation("follows_followed_idTousers", fields: [followed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_follower_idTousers users     @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, followed_id])
  @@schema("public")
}

model group_users {
  group_id  String    @db.Uuid
  user_id   String    @db.Uuid
  joined_at DateTime? @default(now()) @db.Timestamptz(6)
  groups    groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
  @@schema("public")
}

model groups {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique
  description String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  group_users group_users[]

  @@schema("public")
}

model ingredients {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @unique
  unit               String
  recipe_ingredients recipe_ingredients[]

  @@schema("public")
}

model likes {
  user_id String @db.Uuid
  post_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model place_reviews {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  place_id   String    @db.Uuid
  rating     Decimal?  @db.Decimal
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  places     places    @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model places {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  address       String
  description   String?
  tags          String[]
  geolocation   Unsupported("point")?
  rating        Decimal?              @db.Decimal
  open          Boolean?
  type          String?
  place_reviews place_reviews[]

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model post_media {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String  @db.Uuid
  media_url  String
  media_type String?
  position   Int?    @default(0)
  posts      posts   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model posts {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String               @db.Uuid
  type               String
  content            String?
  media_url          String?
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  comments           comments[]
  likes              likes[]
  /**
   * ai_analysis      ai_analysis[]
   * mentions         mentions[]
   * notifications    notifications[]
   */
  post_media         post_media[]
  users              users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes            recipes?
  user_saved_posts   user_saved_posts[]
  user_viewed_posts  user_viewed_posts[]

  @@schema("public")
}

model recipe_ingredients {
  recipe_id     String      @db.Uuid
  ingredient_id String      @db.Uuid
  quantity      Decimal     @db.Decimal
  ingredients   ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes       recipes     @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([recipe_id, ingredient_id])
  @@schema("public")
}

model recipes {
  id                 String               @id @db.Uuid
  name               String
  description        String?
  steps              String?
  difficulty         String?
  time_required      Int?
  recipe_ingredients recipe_ingredients[]
  /**
   * allergies_ingredients allergies_ingredients[]
   * recipe_tag_map        recipe_tag_map[]
   */
  posts              posts                @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model user_saved_posts {
  user_id String @db.Uuid
  post_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@schema("public")
}

model user_viewed_posts {
  user_id   String    @db.Uuid
  post_id   String    @db.Uuid
  viewed_at DateTime? @default(now()) @db.Timestamptz(6)
  posts     posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@schema("public")
}

model user_settings {
  user_id         String   @id @db.Uuid
  is_private      Boolean? @default(false)
  language        String?  @default("es")
  notify_likes    Boolean? @default(true)
  notify_comments Boolean? @default(true)
  notify_follows  Boolean? @default(true)
  theme           String?  @default("light")
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model users {
  id                                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                           String               @unique
  photo_url                          String?
  bio                                String?
  location                           String?
  birth_date                         DateTime             @db.Date
  registered_at                      DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at                         DateTime?            @default(now()) @db.Timestamptz(6)
  comments                           comments[]
  follows_follows_followed_idTousers follows[]            @relation("follows_followed_idTousers")
  follows_follows_follower_idTousers follows[]            @relation("follows_follower_idTousers")
  group_users                        group_users[]
  likes                              likes[]
  place_reviews                      place_reviews[]
  posts                              posts[]
  user_saved_posts                   user_saved_posts[]
  user_viewed_posts                  user_viewed_posts[]
  user_settings                      user_settings?
  /**
   * ai_recipe_requests                          ai_recipe_requests[]
   * mentions                                    mentions[]
   * notifications_notifications_actor_idTousers notifications[]      @relation("notifications_actor_idTousers")
   * notifications_notifications_user_idTousers  notifications[]      @relation("notifications_user_idTousers")
   */

  @@schema("public")
}
