datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

generator client {
  provider = "prisma-client-js"
}

model comments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  post_id    String    @db.Uuid
  text       String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model follows {
  follower_id                      String    @db.Uuid
  followed_id                      String    @db.Uuid
  followed_at                      DateTime? @default(now()) @db.Timestamptz(6)
  users_follows_followed_idTousers users     @relation("follows_followed_idTousers", fields: [followed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_follower_idTousers users     @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_id, followed_id])
  @@schema("public")
}

model group_users {
  group_id  String    @db.Uuid
  user_id   String    @db.Uuid
  joined_at DateTime? @default(now()) @db.Timestamptz(6)
  groups    groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([group_id, user_id])
  @@schema("public")
}

model groups {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        @unique
  description String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  group_users group_users[]

  @@schema("public")
}

model ingredients {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @unique
  unit               String
  recipe_ingredients recipe_ingredients[]

  @@schema("public")
}

model likes {
  user_id String @db.Uuid
  post_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@schema("public")
}

model place_reviews {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  place_id   String    @db.Uuid
  rating     Decimal?  @db.Decimal
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  photo_url  String
  places     places    @relation(fields: [place_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model places {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  media_url     String
  address       String
  description   String?
  tags          String[]
  rating        Decimal?        @db.Decimal
  open          Boolean?
  type          String?
  place_reviews place_reviews[]

  @@schema("public")
}

model post_media {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String  @db.Uuid
  media_url  String
  media_type String?
  position   Int?    @default(0)
  posts      posts   @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model posts {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  type              String
  content           String?
  media_url         String?
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @db.Timestamptz(6)
  comments          comments[]
  likes             likes[]
  post_media        post_media[]
  users             users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes           recipes?
  user_saved_posts  user_saved_posts[]
  user_viewed_posts user_viewed_posts[]

  @@schema("public")
}

model recipe_ingredients {
  recipe_id     String      @db.Uuid
  ingredient_id String      @db.Uuid
  quantity      Decimal     @db.Decimal
  ingredients   ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes       recipes     @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([recipe_id, ingredient_id])
  @@schema("public")
}

model recipes {
  id                 String               @id @db.Uuid
  name               String
  description        String?
  steps              String?
  difficulty         String?
  time_required      Int?
  recipe_ingredients recipe_ingredients[]
  posts              posts                @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model user_saved_posts {
  user_id String @db.Uuid
  post_id String @db.Uuid
  posts   posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@schema("public")
}

model user_viewed_posts {
  user_id   String    @db.Uuid
  post_id   String    @db.Uuid
  viewed_at DateTime? @default(now()) @db.Timestamptz(6)
  posts     posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, post_id])
  @@schema("public")
}

model user_settings {
  user_id         String   @id @db.Uuid
  is_private      Boolean? @default(false)
  language        String?  @default("es")
  notify_likes    Boolean? @default(true)
  notify_comments Boolean? @default(true)
  notify_follows  Boolean? @default(true)
  theme           String?  @default("light")
  users           users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

// ====== USUARIOS ======
model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String    @unique
  photo_url     String?
  bio           String?
  location      String?
  birth_date    DateTime  @db.Date
  registered_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  // Relaciones - Existentes
  comments          comments[]
  follows_followers follows[]           @relation("follows_followed_idTousers")
  follows_following follows[]           @relation("follows_follower_idTousers")
  group_users       group_users[]
  likes             likes[]
  place_reviews     place_reviews[]
  posts             posts[]
  user_saved_posts  user_saved_posts[]
  user_viewed_posts user_viewed_posts[]
  user_settings     user_settings?

  // Relaciones - Chat 1-to-1
  user_contacts            contacts[]        @relation("user_contacts")
  contact_user_contacts    contacts[]        @relation("contact_user_contacts")
  direct_messages_sent     direct_messages[] @relation("sender")
  direct_messages_received direct_messages[] @relation("receiver")

  // Relaciones - Chat Grupal
  user_group_members  group_members[]  @relation("user_group_members")
  user_group_messages group_messages[] @relation("user_group_messages")

  @@schema("public")
}

// ====== CHAT 1-to-1 ======

// Contactos (1-to-1)
model contacts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String    @db.Uuid
  contact_user_id String    @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  user         users @relation("user_contacts", fields: [user_id], references: [id], onDelete: Cascade)
  contact_user users @relation("contact_user_contacts", fields: [contact_user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, contact_user_id])
  @@index([user_id])
  @@index([contact_user_id])
  @@schema("public")
}

// Mensajes directos (1-to-1)
model direct_messages {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String    @db.Uuid
  receiver_id String    @db.Uuid
  content     String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  read_at     DateTime?

  sender   users @relation("sender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver users @relation("receiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@index([sender_id])
  @@index([receiver_id])
  @@schema("public")
}

// ====== CHAT GRUPAL ======

// Grupos de chat
model chat_groups {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  avatar_url  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  group_members  group_members[]
  group_messages group_messages[]

  @@schema("public")
}

// Miembros del grupo
model group_members {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id  String    @db.Uuid
  user_id   String    @db.Uuid
  role      String    @default("member")
  joined_at DateTime? @default(now()) @db.Timestamptz(6)

  chat_group chat_groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user       users       @relation("user_group_members", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([group_id])
  @@index([user_id])
  @@schema("public")
}

// Mensajes del grupo
model group_messages {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id   String    @db.Uuid
  sender_id  String    @db.Uuid
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  chat_group chat_groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  sender     users       @relation("user_group_messages", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([group_id])
  @@index([sender_id])
  @@schema("public")
}
