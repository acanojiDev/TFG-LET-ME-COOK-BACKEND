datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// ====== ENUMERACIONES ======

enum UserType {
  PERSON
  RESTAURANT
  BAR

  @@schema("public")
}

enum PostType {
  PHOTO
  VIDEO
  TEXT
  RECIPE

  @@schema("public")
}

enum StoryType {
  PHOTO
  VIDEO

  @@schema("public")
}

enum PostCategory {
  TRENDING
  ITALIAN
  MEXICAN
  JAPANESE
  CHINESE
  DESSERTS
  VEGAN
  QUICK_EASY
  BURGER
  SEAFOOD
  COCKTAILS
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
  HEALTHY
  COMFORT_FOOD
  STREET_FOOD

  @@schema("public")
}

enum PlaceFilter {
  // Restaurantes
  BURGER
  SEAFOOD
  ITALIAN
  MEXICAN
  CHINESE
  JAPANESE

  // Bares
  COCKTAIL
  WINE
  HAPPY_HOUR
  NIGHTLIFE

  @@schema("public")
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD

  @@schema("public")
}

// ====== USUARIOS Y EMPRESAS ======

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_type     UserType  @default(PERSON)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  // Relación polimórfica: persona o empresa
  person_profile   person_profiles?
  business_profile business_profiles?

  // Relaciones
  posts                    posts[]
  stories                  stories[]
  comments                 comments[]
  likes                    likes[]
  saved_posts              saved_posts[]
  viewed_posts             viewed_posts[]
  viewed_stories           viewed_stories[]
  follows_followers        follows[]           @relation("followed_user")
  follows_following        follows[]           @relation("follower_user")
  place_reviews            place_reviews[]
  user_settings            user_settings?
  user_allergies           user_allergies[]
  user_preferences         user_preferences[]

  // Chat
  contacts_as_user         contacts[]          @relation("user_contacts")
  contacts_as_contact      contacts[]          @relation("contact_user_contacts")
  direct_messages_sent     direct_messages[]   @relation("sender")
  direct_messages_received direct_messages[]   @relation("receiver")

  @@index([user_type])
  @@schema("public")
}

model person_profiles {
  user_id       String    @id @db.Uuid
  username      String    @unique
  full_name     String?
  photo_url     String?
  bio           String?
  location      String?   // Para recomendaciones cercanas
  birth_date    DateTime  @db.Date

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([location])
  @@schema("public")
}

model business_profiles {
  user_id      String    @id @db.Uuid
  business_name String
  photo_url     String?
  bio           String?
  location      String
  specialty     String?
  phone         String?
  website       String?

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([business_name])
  @@index([location])
  @@schema("public")
}

// ====== SEGUIMIENTOS ======

model follows {
  follower_id String    @db.Uuid
  followed_id String    @db.Uuid
  followed_at DateTime  @default(now()) @db.Timestamptz(6)

  follower users @relation("follower_user", fields: [follower_id], references: [id], onDelete: Cascade)
  followed users @relation("followed_user", fields: [followed_id], references: [id], onDelete: Cascade)

  @@id([follower_id, followed_id])
  @@index([follower_id])
  @@index([followed_id])
  @@index([followed_at])
  @@schema("public")
}

// ====== POSTS ======

model posts {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String       @db.Uuid
  post_type   PostType
  title       String?
  description String?
  categories  PostCategory[] // Array de categorías para filtros
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)

  // Relaciones
  user          users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post_media    post_media[]
  recipe        recipes?
  comments      comments[]
  likes         likes[]
  saved_posts   saved_posts[]
  viewed_posts  viewed_posts[]

  @@index([user_id])
  @@index([post_type])
  @@index([created_at(sort: Desc)]) // Para ordenar por recientes
  @@index([categories])
  @@schema("public")
}

model post_media {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id    String  @db.Uuid
  media_url  String
  media_type String  // "image" o "video"
  position   Int     @default(0)

  post posts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@schema("public")
}

// ====== RECETAS ======

model recipes {
  id                 String          @id @db.Uuid
  post_id            String          @unique @db.Uuid
  name               String
  description        String?
  steps              String          // JSON con pasos detallados
  difficulty         DifficultyLevel?
  time_required      Int?            // En minutos
  estimated_cost     Decimal?        @db.Decimal(10, 2) // Costo estimado (opcional)
  servings           Int?            // Número de porciones

  post               posts                @relation(fields: [post_id], references: [id], onDelete: Cascade)
  recipe_ingredients recipe_ingredients[]

  @@index([difficulty])
  @@index([time_required])
  @@schema("public")
}

model ingredients {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String               @unique
  unit               String               // gramos, ml, unidades, etc.

  recipe_ingredients recipe_ingredients[]
  allergen_ingredients allergen_ingredients[]

  @@index([name])
  @@schema("public")
}

model recipe_ingredients {
  recipe_id     String      @db.Uuid
  ingredient_id String      @db.Uuid
  quantity      Decimal     @db.Decimal(10, 2)
  notes         String?

  recipe      recipes     @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  ingredient  ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([recipe_id, ingredient_id])
  @@index([recipe_id])
  @@schema("public")
}

// ====== HISTORIAS (STORIES) ======

model stories {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  story_type  StoryType
  media_url   String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at  DateTime  @db.Timestamptz(6) // 24 horas después de created_at

  user           users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  viewed_stories viewed_stories[]

  @@index([user_id])
  @@index([expires_at])
  @@index([created_at(sort: Desc)])
  @@schema("public")
}

model viewed_stories {
  user_id   String   @db.Uuid
  story_id  String   @db.Uuid
  viewed_at DateTime @default(now()) @db.Timestamptz(6)

  user  users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  story stories @relation(fields: [story_id], references: [id], onDelete: Cascade)

  @@id([user_id, story_id])
  @@index([user_id])
  @@index([story_id])
  @@schema("public")
}

// ====== INTERACCIONES CON POSTS ======

model likes {
  user_id    String   @db.Uuid
  post_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post posts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id])
  @@index([post_id]) // Para contar likes rápido
  @@schema("public")
}

model comments {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  post_id    String    @db.Uuid
  text       String
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post posts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([created_at(sort: Desc)])
  @@schema("public")
}

model saved_posts {
  user_id   String   @db.Uuid
  post_id   String   @db.Uuid
  saved_at  DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post posts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id])
  @@index([user_id])
  @@schema("public")
}

model viewed_posts {
  user_id   String   @db.Uuid
  post_id   String   @db.Uuid
  viewed_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post posts @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id])
  @@index([user_id])
  @@index([post_id])
  @@schema("public")
}

// ====== LUGARES (RESTAURANTES Y BARES) ======

model places {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  media_url   String?
  address     String
  location    String        // Para búsquedas por ubicación
  description String?
  place_type  UserType      // RESTAURANT o BAR
  filters     PlaceFilter[] // Filtros aplicables
  specialty   String?       // Especialidad del lugar
  phone       String?
  website     String?
  is_open     Boolean       @default(true)

  place_reviews place_reviews[]

  @@index([place_type])
  @@index([location])
  @@index([filters])
  @@schema("public")
}

model place_reviews {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  place_id   String    @db.Uuid
  rating     Decimal   @db.Decimal(2, 1) // 0.0 a 5.0
  comment    String?
  photo_url  String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user  users  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  place places @relation(fields: [place_id], references: [id], onDelete: Cascade)

  @@index([place_id])
  @@index([rating])
  @@schema("public")
}

// ====== ALERGIAS Y PREFERENCIAS ======

model allergens {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique

  user_allergies       user_allergies[]
  allergen_ingredients allergen_ingredients[]

  @@index([name])
  @@schema("public")
}

model allergen_ingredients {
  allergen_id   String @db.Uuid
  ingredient_id String @db.Uuid

  allergen   allergens   @relation(fields: [allergen_id], references: [id], onDelete: Cascade)
  ingredient ingredients @relation(fields: [ingredient_id], references: [id], onDelete: Cascade)

  @@id([allergen_id, ingredient_id])
  @@schema("public")
}

model user_allergies {
  user_id     String @db.Uuid
  allergen_id String @db.Uuid

  user     users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  allergen allergens @relation(fields: [allergen_id], references: [id], onDelete: Cascade)

  @@id([user_id, allergen_id])
  @@index([user_id])
  @@schema("public")
}

model preferences {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique // ej: "Vegano", "Sin gluten", "Bajo en calorías"

  user_preferences user_preferences[]

  @@index([name])
  @@schema("public")
}

model user_preferences {
  user_id       String @db.Uuid
  preference_id String @db.Uuid

  user       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  preference preferences @relation(fields: [preference_id], references: [id], onDelete: Cascade)

  @@id([user_id, preference_id])
  @@index([user_id])
  @@schema("public")
}

// ====== CONFIGURACIÓN DE USUARIO ======

model user_settings {
  user_id         String  @id @db.Uuid
  is_private      Boolean @default(false)
  language        String  @default("es")
  notify_likes    Boolean @default(true)
  notify_comments Boolean @default(true)
  notify_follows  Boolean @default(true)
  theme           String  @default("light")

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

// ====== CHAT (1-to-1) ======

model contacts {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  contact_user_id String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  user         users @relation("user_contacts", fields: [user_id], references: [id], onDelete: Cascade)
  contact_user users @relation("contact_user_contacts", fields: [contact_user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, contact_user_id])
  @@index([user_id])
  @@index([contact_user_id])
  @@schema("public")
}

model direct_messages {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sender_id   String    @db.Uuid
  receiver_id String    @db.Uuid
  content     String
  media_url   String?   // Para enviar imágenes/videos en chat
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  read_at     DateTime? @db.Timestamptz(6)

  sender   users @relation("sender", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver users @relation("receiver", fields: [receiver_id], references: [id], onDelete: Cascade)

  @@index([sender_id])
  @@index([receiver_id])
  @@index([created_at(sort: Desc)])
  @@schema("public")
}
